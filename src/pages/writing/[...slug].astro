---
import Base from "../../layouts/InnerLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("writing", (p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const formatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---
<Base
  title={`${post.data.title} — Min Khant Kyaw`}
  description={post.data.description}
>
  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: "Writing", href: "/writing" },
    { label: post.data.title },
  ]} />

  <article>
    <header class="mb-10 lg:mb-14">
      <p class="text-xs uppercase tracking-[0.16em] font-semibold text-accent mb-3">
        {formatter.format(post.data.pubDate)}
      </p>
      <h1 class="text-3xl lg:text-4xl font-bold tracking-tight leading-[1.15] text-text mb-4">
        {post.data.title}
      </h1>
      <p class="text-base lg:text-lg text-text-muted leading-relaxed mb-6">
        {post.data.description}
      </p>

      {post.data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-text-dim">
          {post.data.tags.map((t) => <li>#{t}</li>)}
        </ul>
      )}
    </header>

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_200px] lg:gap-12">
      <div class="prose-project text-text-muted text-base leading-[1.7] space-y-5 [&_a]:text-accent [&_a:hover]:underline [&_h2]:text-xl [&_h2]:lg:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-text [&_h2]:scroll-mt-24 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-text [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:scroll-mt-24 [&_strong]:text-text [&_strong]:font-semibold [&_code]:text-accent [&_code]:bg-surface [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-[0.9em] [&_pre]:bg-surface [&_pre]:border [&_pre]:border-border [&_pre]:rounded-md [&_pre]:p-4 [&_pre]:overflow-x-auto [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-sm [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2 [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-text [&_hr]:border-border [&_hr]:my-10">
        <Content />
      </div>

      {toc.length > 0 && (
        <aside class="hidden lg:block" aria-label="On this page">
          <div class="sticky top-20">
            <p class="text-xs uppercase tracking-[0.16em] font-semibold text-text-dim mb-4">
              On this page
            </p>
            <ul class="space-y-2 border-l border-border">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link
                    data-section={h.slug}
                    data-depth={h.depth}
                    class:list={[
                      "block -ml-px border-l border-transparent py-1 text-sm text-text-muted hover:text-text transition-colors data-[active=true]:border-accent data-[active=true]:text-text data-[active=true]:font-medium data-[active-parent=true]:text-text",
                      h.depth === 2 ? "pl-4" : "pl-7",
                    ]}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </article>
</Base>
