---
import Base from "../layouts/Base.astro";
import ExperienceList from "../components/ExperienceList.astro";
import ProjectList from "../components/ProjectList.astro";
import WritingList from "../components/WritingList.astro";
import { getCollection } from "astro:content";

const experience = await getCollection("experience");
const hasExperience = experience.length > 0;

const writing = (await getCollection("writing")).filter((e) => !e.data.draft);
const hasWriting = writing.length > 0;

const navItems = [
  { id: "about", label: "About" },
  ...(hasExperience ? [{ id: "experience", label: "Experience" }] : []),
  { id: "projects", label: "Projects" },
];
---
<Base title="Min Khant Kyaw — Software Engineer" navItems={navItems}>
  <section id="about" class="mb-16 lg:mb-32 fade-in-up">
    <h2 class="lg:hidden text-text text-base font-bold uppercase tracking-[0.18em] mb-6">About</h2>
    <p class="body-lg text-text-muted">
      I'm a full-stack software engineer working in TypeScript, with a focus on frontend design,
      API design, and system architecture. I care most about user experience and lean toward
      simple solutions over clever ones — my favourite work sits at the intersection of clean
      architecture and interfaces that feel effortless to use.
    </p>
    <p class="body-lg text-text-muted mt-4">
      Currently, I'm a full-time software engineer at
      <a href="https://meeeetup.com" target="_blank" rel="noopener noreferrer" class="text-text font-medium hover:text-accent transition-colors">meeeetup.com</a>,
      where I'm building an AI-powered face-recognition event management platform,
      a coworking-space management platform, and an AI face-identity SaaS. I partner closely
      with our product owner, designer, and the rest of the team to take features from rough
      idea to shipped and usable.
    </p>
    <p class="body-lg text-text-muted mt-4">
      Previously, I've worked at
      <a href="https://www.kbzbank.com/mm/company-profile-mm/" target="_blank" rel="noopener noreferrer" class="text-text font-medium hover:text-accent transition-colors">KBZ Bank</a>
      — Myanmar's largest privately-owned bank, the institution behind KBZPay — and at Myanmar Information Technology (MIT), a 400-person
      enterprise software company building solutions across Myanmar, Singapore, and Thailand
      with platinum partnerships with Microsoft, Oracle, and SAP. Outside of full-time work,
      I also built an expense-splitting and tracking PWA — a side project that started as a
      real personal itch with friends.
    </p>
    <p class="body-lg text-text-muted mt-4">
      In my spare time, you'll usually find me catching up on the latest in tech, reading, or
      spending time with my family.
    </p>
  </section>

  {hasExperience && (
    <section id="experience" class="mb-16 lg:mb-32 fade-in-up">
      <h2 class="lg:hidden text-text text-base font-bold uppercase tracking-[0.18em] mb-6">Experience</h2>
      <ExperienceList />
      <a
        href="/resume"
        class="inline-flex items-center gap-2 mt-10 text-sm font-semibold text-text hover:text-accent transition-colors group"
      >
        View Full Resume
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </section>
  )}

  <section id="projects" class="mb-16 lg:mb-32 fade-in-up">
    <h2 class="lg:hidden text-text text-base font-bold uppercase tracking-[0.18em] mb-6">Projects</h2>
    <ProjectList featuredOnly limit={4} />
    <a
      href="/projects"
      class="inline-flex items-center gap-2 mt-10 text-sm font-semibold text-text hover:text-accent transition-colors group"
    >
      View All Projects
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </section>

  {hasWriting && (
    <section id="writing" class="mb-16 lg:mb-32 fade-in-up">
      <h2 class="lg:hidden text-text text-base font-bold uppercase tracking-[0.18em] mb-6">Writing</h2>
      <WritingList limit={3} />
      <a
        href="/writing"
        class="inline-flex items-center gap-2 mt-10 text-sm font-semibold text-text hover:text-accent transition-colors group"
      >
        View All Writings
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </section>
  )}
</Base>
