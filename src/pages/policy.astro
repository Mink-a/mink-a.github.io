---
import Base from "../layouts/InnerLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---
<Base
  title="Policy — Min Khant Kyaw"
  description="Use and content policy for minkhantkyaw.com."
>
  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: "Policy" },
  ]} />

  <article>
    <header class="mb-10 lg:mb-14">
      <p class="text-xs uppercase tracking-[0.16em] font-semibold text-accent mb-3">
        Policy
      </p>
      <h1 class="text-3xl lg:text-4xl font-bold tracking-tight leading-[1.15] text-text mb-4">
        Use and content policy
      </h1>
      <p class="text-base lg:text-lg text-text-muted leading-relaxed">
        The terms under which the content of this site is published.
      </p>
    </header>

    <div class="prose-project text-text-muted text-base leading-[1.7] space-y-5 [&_h2]:text-xl [&_h2]:lg:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-text [&_a]:text-accent [&_a:hover]:underline">
      <h2>Content ownership</h2>
      <p>Words, designs, and code samples published on this site are © Min Khant Kyaw unless otherwise credited. Open-source code linked from project pages is governed by its own LICENSE file in the relevant repository.</p>

      <h2>Reuse</h2>
      <p>You may quote short excerpts of writing with attribution. For longer reuse, syndication, or commercial use, email <a href="mailto:hello@minkhantkyaw.com">hello@minkhantkyaw.com</a> first.</p>

      <h2>No warranty</h2>
      <p>Opinions here are personal, not professional advice. Content is provided as-is; the author makes no warranty regarding accuracy, completeness, or fitness for any particular purpose.</p>
    </div>
  </article>
</Base>
