---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { stack } from "../data/stack";

const experience = (await getCollection("experience")).sort(
  (a, b) => b.data.order - a.data.order
);
const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.order - a.data.order
);

const formatRange = (s: string, e: string) => `${s} — ${e}`;
---
<Base
  title="Resume — Min Khant Kyaw"
  description="Resume of Min Khant Kyaw — full-stack software engineer focused on modern TypeScript, Astro, Next.js, Bun, Hono, PostgreSQL."
>
  <article
    itemscope
    itemtype="https://schema.org/Person"
    class="resume text-text-muted leading-relaxed [&_h1]:h-2 [&_h1]:text-text [&_h2]:h-3 [&_h2]:text-text [&_h2]:mt-12 [&_h2]:mb-5 [&_h2]:border-b [&_h2]:border-border [&_h2]:pb-2 [&_h3]:text-text [&_h3]:font-semibold [&_h3]:text-base [&_h3]:mt-6 [&_h3]:mb-1 [&_a]:text-accent [&_a:hover]:underline [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-1 [&_ul]:mt-2 [&_strong]:text-text [&_strong]:font-semibold"
  >
    <header>
      <h1 itemprop="name">Min Khant Kyaw</h1>
      <p class="text-accent text-base mt-1" itemprop="jobTitle">Software Engineer</p>
      <p class="text-sm mt-4">
        <a href="mailto:hello@minkhantkyaw.com" itemprop="email">hello@minkhantkyaw.com</a>
        <span class="text-text-dim mx-2" aria-hidden="true">·</span>
        <a href="https://github.com/mink-a" target="_blank" rel="noopener noreferrer">github.com/mink-a</a>
        <span class="text-text-dim mx-2" aria-hidden="true">·</span>
        <a href="https://minkhantkyaw.com" itemprop="url">minkhantkyaw.com</a>
      </p>
    </header>

    <section>
      <h2>Summary</h2>
      <p>
        Full-stack software engineer focused on modern TypeScript ecosystems. I design and
        develop performant web applications with strong attention to maintainability, user
        experience, and scalable architecture — across frontend, backend, database design,
        APIs, authentication systems, and cloud-native deployment.
      </p>
      <p class="mt-3">
        Day-to-day stack: Astro, Next.js, Bun, Hono, PostgreSQL. I care about clean APIs,
        well-named code, fast feedback loops, and interfaces that respect the user's attention.
      </p>
    </section>

    <section>
      <h2>Experience</h2>
      {experience.map((entry) => (
        <article class="mt-6 first:mt-0" itemprop="workExperience" itemscope itemtype="https://schema.org/OrganizationRole">
          <h3>
            <span itemprop="roleName">{entry.data.role}</span>
            <span class="text-text-muted font-normal"> · </span>
            <span itemprop="worksFor">{entry.data.company}</span>
          </h3>
          <p class="text-text-dim text-sm">
            <time>{formatRange(entry.data.start, String(entry.data.end))}</time>
          </p>
          <p class="mt-2">{entry.data.description}</p>
          <p class="text-text-dim text-sm mt-1">
            <strong>Tech:</strong> {entry.data.tech.join(", ")}
          </p>
        </article>
      ))}
    </section>

    <section>
      <h2>Stack</h2>
      <ul>
        {stack.map((group) => (
          <li>
            <strong>{group.category}:</strong> {group.items.map((i) => i.name).join(", ")}
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Projects</h2>
      {projects.map((project) => (
        <article class="mt-6 first:mt-0">
          <h3>{project.data.title}</h3>
          <p class="text-text-dim text-sm">{project.data.type}</p>
          <p class="mt-2">{project.data.description}</p>
          <p class="text-text-dim text-sm mt-1">
            <strong>Tech:</strong> {project.data.tech.join(", ")}
          </p>
        </article>
      ))}
    </section>

    <section class="mt-10 text-sm text-text-dim">
      <p>
        Last updated {new Date().toISOString().slice(0, 10)}. View the full site at
        <a href="/">minkhantkyaw.com</a>.
      </p>
    </section>
  </article>

  <a
    href="/"
    class="inline-flex items-center gap-2 mt-16 text-sm font-semibold text-text hover:text-accent transition-colors group"
  >
    <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
    Back home
  </a>
</Base>
