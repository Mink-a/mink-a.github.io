---
import Base from "../layouts/InnerLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---
<Base
  title="Privacy — Min Khant Kyaw"
  description="Privacy notice for minkhantkyaw.com."
>
  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: "Privacy" },
  ]} />

  <article>
    <header class="mb-10 lg:mb-14">
      <p class="text-xs uppercase tracking-[0.16em] font-semibold text-accent mb-3">
        Privacy
      </p>
      <h1 class="text-3xl lg:text-4xl font-bold tracking-tight leading-[1.15] text-text mb-4">
        Privacy notice
      </h1>
      <p class="text-base lg:text-lg text-text-muted leading-relaxed">
        This is a personal portfolio site. It collects nothing about you.
      </p>
    </header>

    <div class="prose-project text-text-muted text-base leading-[1.7] space-y-5 [&_h2]:text-xl [&_h2]:lg:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-text [&_a]:text-accent [&_a:hover]:underline">
      <h2>What I collect</h2>
      <p>Nothing. There is no analytics script, no tracking pixel, no cookie set by this site. Your visit is not logged beyond standard web server access logs (IP, user-agent, requested path) which are retained briefly for operational debugging only.</p>

      <h2>Third parties</h2>
      <p>Outbound links to GitHub, LinkedIn, and similar services are subject to each service's own privacy policies. This site embeds no third-party iframes, ads, or social trackers.</p>

      <h2>Contact</h2>
      <p>If you have any questions about this notice, email <a href="mailto:hello@minkhantkyaw.com">hello@minkhantkyaw.com</a>.</p>
    </div>
  </article>
</Base>
