---
import { getImageData } from "../lib/images";

interface Props {
  /** Public URL under `public/`, e.g. `/assets/covers/x.webp`. */
  src: string;
  alt: string;
  /** Force a display ratio (e.g. "16 / 10"); defaults to the intrinsic ratio. */
  ratio?: string;
  /** Classes for the wrapper (borders, radius, spacing live here). */
  class?: string;
  /** Extra classes for the <img> (e.g. hover transforms). */
  imgClass?: string;
  loading?: "lazy" | "eager";
  /** LCP images: eager-load and hint high fetch priority to the browser. */
  priority?: boolean;
  sizes?: string;
}

const {
  src,
  alt,
  ratio,
  class: wrapperClass,
  imgClass,
  loading = "lazy",
  priority = false,
  sizes,
} = Astro.props;

const { width, height, placeholder } = await getImageData(src);
const aspect = ratio ?? (width && height ? `${width} / ${height}` : "16 / 9");
const style = [
  `aspect-ratio: ${aspect};`,
  placeholder ? `background-image: url('${placeholder}');` : "",
]
  .join(" ")
  .trim();
---
<div
  class:list={["relative overflow-hidden bg-cover bg-center bg-no-repeat", wrapperClass]}
  style={style}
>
  <img
    src={src}
    alt={alt}
    width={width || undefined}
    height={height || undefined}
    loading={priority ? "eager" : loading}
    fetchpriority={priority ? "high" : undefined}
    decoding="async"
    sizes={sizes}
    class:list={["blur-up absolute inset-0 h-full w-full object-cover", imgClass]}
  />
</div>
