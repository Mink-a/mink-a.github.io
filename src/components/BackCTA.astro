---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---
<div class="mt-20 lg:mt-28 pt-10 lg:pt-12 border-t border-border">
  <a
    href={href}
    class="group inline-flex items-center gap-3 text-base font-semibold text-text hover:text-accent transition-colors"
  >
    <span
      aria-hidden="true"
      class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border-strong text-text-muted group-hover:border-accent group-hover:text-accent group-hover:-translate-x-0.5 transition-all"
    >
      ←
    </span>
    {label}
  </a>
</div>
