---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

const site = Astro.site ?? new URL("https://minkhantkyaw.com");
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.label,
    item: new URL(item.href ?? Astro.url.pathname, site).href,
  })),
};
---
<nav aria-label="Breadcrumb" class="mb-10 lg:mb-12 flex items-center min-h-9 lg:min-h-10">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
    {items.map((item, i) => {
      const isLast = i === items.length - 1;
      return (
        <li class="flex items-center gap-2">
          {item.href && !isLast ? (
            <a
              href={item.href}
              class="text-text-muted hover:text-accent transition-colors font-medium"
            >
              {item.label}
            </a>
          ) : (
            <span class="text-text font-medium" aria-current={isLast ? "page" : undefined}>
              {item.label}
            </span>
          )}
          {!isLast && (
            <span aria-hidden="true" class="text-text-dim">/</span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
