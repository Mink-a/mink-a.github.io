---
// Floating chat assistant, rendered globally (Base + InnerLayout). Wrapped in a
// transition:persist container so it and its state survive ClientRouter
// view-transition navigations. No <form> on purpose: a form submit would be
// intercepted by the ClientRouter and navigate the page.
---
<div id="chat-assistant" transition:persist>
<button
  id="chat-launcher"
  type="button"
  aria-expanded="false"
  aria-controls="chat-panel"
  aria-label="Chat with Min's assistant"
  class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-accent text-bg shadow-lg shadow-accent-glow transition-transform hover:scale-105 focus-visible:scale-105 max-sm:aria-expanded:hidden"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
  </svg>
</button>

<section
  id="chat-panel"
  role="dialog"
  aria-label="Min's portfolio assistant"
  class="hidden fixed left-0 right-0 top-0 h-dvh z-50 flex flex-col bg-surface/60 backdrop-blur-xl overflow-hidden sm:left-auto sm:top-auto sm:bottom-24 sm:right-5 sm:h-[520px] sm:w-[360px] sm:max-w-[calc(100vw-2.5rem)] sm:max-h-[calc(100vh-8rem)] sm:rounded-2xl sm:border sm:border-border-strong sm:shadow-2xl"
>
  <header class="flex items-center justify-between border-b border-border px-4 py-3">
    <div class="flex flex-col">
      <span class="text-sm font-semibold text-text">Ask about Min</span>
      <span class="text-xs text-text-dim">AI assistant · answers from his portfolio</span>
    </div>
    <div class="flex items-center gap-1">
      <button
        id="chat-clear"
        type="button"
        aria-label="Clear conversation"
        title="Clear conversation"
        class="flex h-8 w-8 items-center justify-center rounded-md text-text-muted hover:bg-surface-2 hover:text-text"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
          <path d="M10 11v6M14 11v6" />
        </svg>
      </button>
      <button
        id="chat-close"
        type="button"
        aria-label="Close chat"
        class="flex h-8 w-8 items-center justify-center rounded-md text-text-muted hover:bg-surface-2 hover:text-text"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
  </header>

  <div id="chat-messages" class="flex-1 space-y-3 overflow-y-auto px-4 py-4" aria-live="polite"></div>

  <div id="chat-form" class="flex items-end gap-2 border-t border-border p-3">
    <textarea
      id="chat-input"
      rows="1"
      placeholder="Ask a question…"
      autocomplete="off"
      class="flex-1 resize-none rounded-lg border border-border bg-bg px-3 py-2 text-sm text-text placeholder:text-text-dim focus:border-accent focus:outline-none"
    ></textarea>
    <button
      id="chat-send"
      type="button"
      aria-label="Send message"
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent text-bg transition-opacity hover:opacity-90 disabled:opacity-50"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 2 11 13M22 2l-7 20-4-9-9-4Z" />
      </svg>
    </button>
  </div>
</section>
</div>

<script>
  import "../scripts/chat-widget";
</script>
