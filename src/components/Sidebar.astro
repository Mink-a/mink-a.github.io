---
import { Icon } from "astro-icon/components";

interface NavItem { id: string; label: string; }

interface Props {
  /** Section anchors when on home. Empty array means "no in-page nav" (inner routes). */
  navItems?: NavItem[];
  /** Compact identity for inner routes — smaller name, no bio. */
  compact?: boolean;
}

const { navItems = [], compact = false } = Astro.props;
---

<aside
  transition:name="sidebar-shell"
  class:list={["lg:sticky lg:top-0 lg:h-screen lg:flex lg:flex-col lg:justify-between pb-12 lg:pb-24", compact ? "pt-8 lg:pt-12" : "pt-12 lg:pt-24"]}
>
  <div>
    <a href="/" class="block group">
      {compact ? (
        <h1
          transition:name="identity-name"
          class="text-text text-2xl lg:text-3xl font-bold tracking-tight group-hover:text-accent transition-colors"
        >
          Min Khant Kyaw
        </h1>
      ) : (
        <h1 transition:name="identity-name" class="h-display text-text">Min Khant Kyaw</h1>
      )}
    </a>
    {compact ? (
      <p class="mt-1 text-text-muted text-sm">Software Engineer</p>
    ) : (
      <>
        <p class="mt-3 text-text text-xl lg:text-2xl font-medium">Software Engineer</p>
        <p
          id="bio"
          class="mt-5 text-text-muted text-base max-w-xs min-h-[3.4em]"
          data-bio-target
        >
          In the zone. In the code. In production.
        </p>
      </>
    )}

    {navItems.length > 0 && (
      <nav class="mt-12 lg:mt-20 hidden lg:block" aria-label="Section navigation">
        <ul class="space-y-4">
          {navItems.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                data-nav-link
                data-section={item.id}
                class="group inline-flex items-center gap-4 py-2"
              >
                <span class="nav-indicator inline-block h-px bg-text-dim transition-all duration-200 ease-out group-hover:bg-accent" />
                <span class="text-text-dim text-xs uppercase tracking-[0.18em] font-semibold transition-colors duration-200 group-hover:text-text">
                  {item.label}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  <div transition:name="sidebar-footer" class="mt-12 lg:mt-0">
    <div class="inline-flex items-center gap-5 text-text-muted">
      <a transition:name="social-github" href="https://github.com/mink-a" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="group hover:text-text transition-colors duration-200 ease-out">
        <Icon name="simple-icons:github" class="w-6 h-6 transition-transform duration-300 ease-out group-hover:scale-110 group-hover:-translate-y-0.5" aria-hidden="true" />
      </a>
      <a transition:name="social-linkedin" href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="group hover:text-text transition-colors duration-200 ease-out">
        <Icon name="simple-icons:linkedin" class="w-6 h-6 transition-transform duration-300 ease-out group-hover:-translate-y-0.5 group-hover:rotate-[-3deg]" aria-hidden="true" />
      </a>
      <a transition:name="social-telegram" href="https://t.me/" target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="group hover:text-text transition-colors duration-200 ease-out">
        <Icon name="simple-icons:telegram" class="w-6 h-6 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:rotate-12" aria-hidden="true" />
      </a>
      <a transition:name="social-email" href="mailto:hello@minkhantkyaw.com" aria-label="Email" class="group hover:text-text transition-colors duration-200 ease-out">
        <Icon name="lucide:mail" class="w-6 h-6 transition-transform duration-300 ease-out group-hover:-translate-y-0.5 group-hover:rotate-[-6deg]" aria-hidden="true" />
      </a>
      <span class="w-px h-6 bg-border" aria-hidden="true"></span>
      <a
        transition:name="resume-cta"
        href="/resume"
        class="group inline-flex items-center gap-2 text-text hover:text-accent transition-colors text-xs uppercase tracking-[0.16em] font-semibold whitespace-nowrap"
      >
        Resume
        <span aria-hidden="true" class="transition-transform duration-200 ease-out group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</aside>

<style>
  .nav-indicator {
    width: 24px;
  }
  [data-nav-link][data-active="true"] .nav-indicator,
  [data-nav-link]:hover .nav-indicator {
    width: 80px;
    background-color: var(--color-text);
  }
  [data-nav-link][data-active="true"] span:last-child {
    color: var(--color-text);
  }
</style>
