---
import Tag from "./Tag.astro";

interface Props {
  role: string;
  company: string;
  companyUrl?: string;
  start: string;
  end: string;
  description: string;
  tech: string[];
  isCurrent?: boolean;
}
const { role, company, companyUrl, start, end, description, tech, isCurrent = false } = Astro.props;

function formatRange(s: string, e: string) {
  return `${s} — ${e}`;
}
---
<article class="hover-dim-item group">
  <p class={`text-xs uppercase tracking-[0.16em] font-semibold mb-2 ${isCurrent ? "text-accent" : "text-text-dim"}`}>
    {formatRange(start, end)}
  </p>
  <h3 class="h-3 group-hover:text-accent transition-colors mb-2">
    <span class="text-text">{role}</span>
    <span class="text-text-muted"> at </span>
    {companyUrl ? (
      <a href={companyUrl} target="_blank" rel="noopener noreferrer" class="text-text hover:text-accent transition-colors">{company}</a>
    ) : (
      <span class="text-text">{company}</span>
    )}
  </h3>
  <p class="text-text-muted">{description}</p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {tech.map((t) => <li><Tag label={t} /></li>)}
  </ul>
</article>
