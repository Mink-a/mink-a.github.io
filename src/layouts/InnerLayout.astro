---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Sidebar from "../components/Sidebar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:bg-accent focus:text-bg focus:px-4 focus:py-2 focus:rounded-md focus:z-[100]">
      Skip to content
    </a>
    <div class="max-w-screen-xl mx-auto px-5 sm:px-6 md:px-8 lg:px-4 grid lg:grid-cols-[minmax(0,280px)_1fr] gap-8 lg:gap-16">
      <Sidebar compact={true} />
      <main id="main" transition:name="main-frame" class="min-w-0 pt-8 lg:pt-12 pb-12 lg:pb-24">
        <slot />
        <div class="dot-pattern-space mt-20 lg:mt-28" aria-hidden="true"></div>
        <Footer />
      </main>
    </div>

    <ThemeToggle />

    <button
      id="back-to-top"
      type="button"
      aria-label="Back to top"
      data-visible="false"
      class="fixed bottom-6 right-6 lg:bottom-8 lg:right-8 z-40 inline-flex h-11 w-11 items-center justify-center rounded-full border border-border-strong bg-surface/80 backdrop-blur-sm text-text-muted opacity-0 translate-y-2 pointer-events-none transition-all duration-200 ease-out hover:text-accent hover:border-accent data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0 data-[visible=true]:pointer-events-auto"
    >
      <span aria-hidden="true" class="text-lg leading-none">↑</span>
    </button>
  </body>
</html>

<script>
  import "../scripts/scroll-spy";
  import "../scripts/entry-anim";
  import "../scripts/img-blur";
  import "../scripts/nav-scroll";
  import "../scripts/toc-spy";
  import "../scripts/back-to-top";
  import "../scripts/theme";
</script>
