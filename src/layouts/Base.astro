---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Sidebar from "../components/Sidebar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";

interface NavItem { id: string; label: string; }
interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  navItems?: NavItem[];
}

const { navItems = [] } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:bg-accent focus:text-bg focus:px-4 focus:py-2 focus:rounded-md focus:z-[100]">
      Skip to content
    </a>
    <div class="max-w-screen-xl mx-auto px-5 sm:px-6 md:px-8 lg:px-4 grid lg:grid-cols-[minmax(0,380px)_minmax(0,720px)] gap-8 lg:gap-16">
      <Sidebar navItems={navItems} compact={false} />
      <div class="dot-pattern-divider lg:hidden" aria-hidden="true"></div>
      <main id="main" transition:name="main-frame" class="min-w-0 pt-12 lg:pt-24 pb-12 lg:pb-24">
        <slot />
        <Footer />
      </main>
    </div>
    <ThemeToggle />
  </body>
</html>

<script>
  import "../scripts/scroll-spy";
  import "../scripts/entry-anim";
  import "../scripts/img-blur";
  import "../scripts/bio-scramble";
  import "../scripts/nav-scroll";
  import "../scripts/theme";
</script>
