---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}
const { frontmatter } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={frontmatter.description ?? "Resume"} />
    <title>{frontmatter.title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:bg-accent focus:text-bg focus:px-4 focus:py-2 focus:rounded-md focus:z-[100]">
      Skip to content
    </a>
    <div class="max-w-3xl mx-auto px-6 py-10">
      <header class="flex items-center justify-between mb-16">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-text-muted hover:text-text transition-colors group">
          <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
          Back to Home
        </a>
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-accent text-bg font-semibold text-sm hover:bg-accent/90 transition-colors"
        >
          <span aria-hidden="true">⬇</span>
          Download PDF
        </a>
      </header>
      <article id="main" class="resume" itemscope itemtype="https://schema.org/Person">
        <slot />
      </article>
    </div>

    <style is:global>
      .resume {
        color: var(--color-text-muted);
        line-height: 1.7;
      }

      /* Top identity block — first h1 + next two paragraphs are centered. */
      .resume > h1 {
        font-size: clamp(40px, 5.5vw, 52px);
        font-weight: 700;
        color: var(--color-text);
        text-align: center;
        letter-spacing: -0.03em;
        margin: 0 0 12px;
      }
      .resume > h1 + p {
        text-align: center;
        color: var(--color-text);
        font-weight: 600;
        margin: 0 0 24px;
      }
      .resume > h1 + p + p {
        text-align: center;
        color: var(--color-text-muted);
        font-size: 15px;
        margin: 0;
      }

      /* Section dividers */
      .resume hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 48px 0;
      }

      /* Section + role headings */
      .resume h2 {
        font-size: 22px;
        font-weight: 600;
        color: var(--color-text);
        letter-spacing: -0.02em;
        margin: 0 0 16px;
      }
      .resume h3 {
        font-size: 17px;
        font-weight: 600;
        color: var(--color-text);
        margin: 28px 0 4px;
      }

      .resume p {
        margin: 12px 0 0;
      }

      .resume strong {
        color: var(--color-text);
        font-weight: 600;
      }

      /* Date lines use *italics* in source but should render dim, not italic. */
      .resume em {
        font-style: normal;
        color: var(--color-text-dim);
        font-size: 14px;
      }

      .resume a {
        color: var(--color-accent);
      }
      .resume a:hover {
        text-decoration: underline;
      }

      .resume ul {
        list-style: disc;
        padding-left: 24px;
        margin-top: 8px;
      }
      .resume ul li {
        margin-top: 4px;
      }

      /* Print: hide the header buttons; let the resume itself fill the page. */
      @media print {
        body { background: white; color: black; }
        .resume,
        .resume > h1,
        .resume > h1 + p,
        .resume strong,
        .resume h2,
        .resume h3 {
          color: black !important;
        }
        .resume a { color: black !important; }
        .resume hr { border-color: #ccc !important; }
        header { display: none !important; }
      }
    </style>
  </body>
</html>
